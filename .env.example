# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | production
NODE_ENV=development
# Port the HTTP server listens on (Render provides this automatically)
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=globinn_hotels
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Set to true when the database requires SSL (e.g. a managed cloud database)
DATABASE_SSL=false